<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical"
        tools:context=".Dashboard"
     >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".Dashboard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:id="@+id/prayid"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:visibility="gone"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/menuBtn"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    android:src="@drawable/menuicon"
                    app:tint="@color/black" />

                <TextView
                    android:id="@+id/dayTxt"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/ralewaybold"
                    android:gravity="center_vertical|right"
                    android:text="--/--"
                    android:textColor="@color/onSurface2"
                    android:textSize="16sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:visibility="gone"
                android:fontFamily="@font/kufi"
                android:gravity="center"
                android:text="بِسْمِ ٱللَّٰهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"
                android:textColor="@color/onSurface2"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/headingTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:visibility="gone"
                android:fontFamily="@font/ralewaybold"
                android:gravity="center"
                android:text="@string/app_name"
                android:textColor="@color/onSurface2"
                android:textSize="16sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:id="@+id/rel1"
                android:layout_height="wrap_content"
                >
                <ImageView
                    android:layout_width="wrap_content"
                    android:id="@+id/profile"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_margin="@dimen/size_10"
                    android:src="@drawable/profile_image"
                    ></ImageView>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/size_10"
                    android:layout_marginEnd="@dimen/size_10"
                    android:layout_marginStart="@dimen/size_10"
                    android:layout_marginTop="@dimen/size_12"
                    android:layout_toLeftOf="@+id/profile"
                    android:src="@drawable/salam_txt"></ImageView>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/mores"
                    android:layout_marginBottom="@dimen/size_10"
                    android:layout_marginEnd="@dimen/size_10"
                    android:layout_marginStart="@dimen/size_10"
                    android:layout_marginTop="@dimen/size_12"
                    android:src="@drawable/mooore"></ImageView>

            </RelativeLayout>
<RelativeLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="40dp"
    android:background="@drawable/bg_search"
    >
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/search"
        android:layout_marginLeft="@dimen/size_12"
        android:layout_centerVertical="true"
        ></ImageView>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/search_txt"
        android:layout_centerVertical="true"
        android:layout_marginRight="@dimen/margin_20dp"
        android:layout_alignParentRight="true"
        ></ImageView>

</RelativeLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/size_12"
                android:layout_height="wrap_content"


                >

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/mktab"
                    android:id="@+id/maktab"
                    android:layout_marginHorizontal="@dimen/size_12"
                    ></ImageView>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/qurantext"

                    android:layout_marginHorizontal="@dimen/size_12"

                    android:src="@drawable/quran1"
                    ></ImageView>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/azkr"

                    android:layout_marginHorizontal="@dimen/size_12"

                    android:src="@drawable/azkar"
                    ></ImageView>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/salah"
                    android:layout_marginHorizontal="@dimen/size_12"
                    android:src="@drawable/salat"
                    ></ImageView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/size_12"
                android:layout_height="wrap_content"


                >

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/main_card"
                    android:id="@+id/mcard"
                    android:padding="5dp"
                    android:background="@drawable/select_book"
                    android:layout_marginHorizontal="@dimen/size_10"
                    ></ImageView>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/hadisnabvi"
                     android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/size_10"

                    android:src="@drawable/hadees_nabvi"
                    ></ImageView>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/ulom"
                     android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/size_10"

                    android:src="@drawable/quran_uloom"
                    ></ImageView>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/akim"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/size_10"
                    android:src="@drawable/islamic_aqida"
                    ></ImageView>

            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cat_name"
                android:layout_marginTop="@dimen/margin_20dp"
                android:layout_marginLeft="90dp"
                ></ImageView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/margin_20dp"
                >

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/unwan_kitab"
                    ></ImageView>
                <androidx.legacy.widget.Space
                    android:layout_width="40dp"
                    android:layout_height="wrap_content">

                </androidx.legacy.widget.Space>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/unwan_kitab_m"
                    ></ImageView>
            </LinearLayout>
 <ImageView
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:src="@drawable/cart_btn"
     android:layout_marginRight="130dp"
     ></ImageView>
          <!--  <fragment
                android:layout_height="380dp"
                android:layout_width="match_parent"
                android:id="@+id/prayerFragment"
                android:name="islam.muslim.app.ui.prayer.PrayerFragment"
                android:label="PrayerFragment"
                tools:layout="@layout/activity_prayer"/>-->

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:gravity="center"
            android:visibility="gone"
            android:id="@+id/moreitemsid"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/quran"
                android:id="@+id/quran"
                ></ImageView>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/calender"
                android:id="@+id/calculater"
                ></ImageView>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/tasbeeh"
                android:id="@+id/tasbehh"
                ></ImageView>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/duas"
                android:id="@+id/more"
                ></ImageView>

        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:id="@+id/rellast"
            android:visibility="gone"
            android:layout_height="wrap_content"
            >
            <ImageView
                android:layout_width="wrap_content"
                android:id="@+id/mmmm"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_margin="@dimen/size_10"
                android:src="@drawable/mooore"
                ></ImageView>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_10"
                android:layout_marginEnd="@dimen/size_10"
                android:layout_marginStart="@dimen/size_10"
                android:layout_marginTop="@dimen/size_12"
                android:layout_toLeftOf="@+id/mmmm"
                android:src="@drawable/txt"></ImageView>

        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dashboardRV"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:visibility="gone"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="3"
            tools:listitem="@layout/dashboard_cell"
            android:layout_weight="1"
            android:layout_margin="10dp" />

        <com.google.android.gms.ads.AdView xmlns:ads="http://schemas.android.com/apk/res-auto"
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            ads:adSize="BANNER"
            android:visibility="gone"
            android:translationZ="3dp"
            ads:adUnitId="@string/banner_adunit_id" />

    </LinearLayout>
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/navigation1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/nav_bottom"
            android:layout_gravity="bottom"
            app:itemIconTint="@color/onSurface2"
            app:itemIconSize="50dp"
            app:labelVisibilityMode="unlabeled"
             android:layout_alignParentBottom="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:menu="@menu/navigationbar" />
    </RelativeLayout>

</layout>