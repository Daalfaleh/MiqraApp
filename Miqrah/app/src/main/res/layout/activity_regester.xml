<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Regester">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/lines2"
        android:id="@+id/imagvmain"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"></ImageView>


    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/title"
        android:src="@drawable/tt2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imagvmain"></ImageView>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">

        <EditText
            android:id="@+id/edUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textAlignment="center"
            android:background="@drawable/user_name"></EditText>


        <androidx.legacy.widget.Space
            android:layout_width="wrap_content"
            android:layout_height="@dimen/margin_10dp"></androidx.legacy.widget.Space>


        <EditText
            android:id="@+id/edemail"
            android:layout_width="wrap_content"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_height="wrap_content"
            android:background="@drawable/id"></EditText>
        <androidx.legacy.widget.Space
            android:layout_width="wrap_content"
            android:layout_height="@dimen/margin_10dp"></androidx.legacy.widget.Space>

        <EditText
            android:id="@+id/edpass"
            android:layout_width="wrap_content"
            android:textStyle="bold"
            android:textAlignment="center"
            android:inputType="textPassword"
            android:layout_height="wrap_content"
            android:background="@drawable/password"></EditText>
        <androidx.legacy.widget.Space
            android:layout_width="wrap_content"
            android:layout_height="@dimen/margin_10dp"></androidx.legacy.widget.Space>


        <androidx.legacy.widget.Space
            android:layout_width="wrap_content"
            android:layout_height="@dimen/margin_20dp"></androidx.legacy.widget.Space>

        <Button
            android:id="@+id/loginbtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/register"></Button>

    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="9dp"
        android:src="@drawable/agree"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2"></ImageView>
</androidx.constraintlayout.widget.ConstraintLayout>